{"indexed": {"date-parts": [[2025, 8, 15]], "date-time": "2025-08-15T00:21:25Z", "timestamp": 1755217285071, "version": "3.43.0"}, "reference-count": 0, "publisher": "Wiley", "issue": "1", "license": [{"start": {"date-parts": [[2025, 7, 28]], "date-time": "2025-07-28T00:00:00Z", "timestamp": 1753660800000}, "content-version": "vor", "delay-in-days": 88, "URL": "http://onlinelibrary.wiley.com/termsAndConditions#vor"}], "content-domain": {"domain": ["onlinelibrary.wiley.com"], "crossmark-restriction": true}, "short-container-title": ["Intl Review of Mission"], "published-print": {"date-parts": [[2025, 5]]}, "DOI": "10.1111/irom.70001", "type": "journal-article", "created": {"date-parts": [[2025, 7, 29]], "date-time": "2025-07-29T00:54:49Z", "timestamp": 1753750489000}, "page": "3-5", "update-policy": "https://doi.org/10.1002/crossmark_policy", "source": "Crossref", "is-referenced-by-count": 0, "title": ["Guest Editorial"], "prefix": "10.1111", "volume": "114", "author": [{"ORCID": "https://orcid.org/0000-0002-1958-1189", "authenticated-orcid": false, "given": "Mutale Mulenga", "family": "Kaunda", "sequence": "first", "affiliation": []}], "member": "311", "published-online": {"date-parts": [[2025, 7, 28]]}, "container-title": ["International Review of Mission"], "language": "en", "link": [{"URL": "https://onlinelibrary.wiley.com/doi/pdf/10.1111/irom.70001", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2025, 8, 5]], "date-time": "2025-08-05T09:17:18Z", "timestamp": 1754385438000}, "score": 0.0, "resource": {"primary": {"URL": "https://onlinelibrary.wiley.com/doi/10.1111/irom.70001"}}, "issued": {"date-parts": [[2025, 5]]}, "references-count": 0, "journal-issue": {"issue": "1", "published-print": {"date-parts": [[2025, 5]]}}, "alternative-id": ["10.1111/irom.70001"], "URL": "https://doi.org/10.1111/irom.70001", "archive": ["Portico"], "ISSN": ["0020-8582", "1758-6631"], "issn-type"